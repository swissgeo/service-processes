
# used for local development
ROOT_PATH=/api/adm/v1
PUBLISH_OPENAPI_SPEC=1
DOC_PREFIX_PATH=/svc-prc

CORS_ORIGIN_REGEX=http://localhost:\\d+

DB_ADMIN_USER=postgres
DB_ADMIN_PW=postgres
DB_NAME=service_processes
DB_USER=service_processes
DB_PW=service_processes
DB_PORT=15432
DB_HOST=localhost

# OTEL configuration
OTEL_SDK_DISABLE=true
OTEL_PYTHON_EXCLUDED_URLS=/checker
OTEL_ENABLE_OTLP_EXPORTER=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Metric exporter config
OTEL_ENABLE_METRICS=true
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_METRIC_EXPORT_TIMEOUT=3000

# Use new semantic convention for HTTP
OTEL_SEMCONV_STABILITY_OPT_IN=http

# Logging configuration
LOGGING_ENABLE_DEV_SERVER_LOGGING=true
LOGGING_CONFIG_FILE=./logging-local-config.yaml
