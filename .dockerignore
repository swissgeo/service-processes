# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Logs and runtime files
*.log
*.sqlite3
*.db
*.pid

# OS files
.DS_Store
Thumbs.db

# Docker files (ignore previous builds)
docker-compose.override.yml
*.swp

# Git files
.git
.gitignore
*.orig

# Tests and development scripts (optional)
tests/
*.pytest_cache/
.coverage
test_*
app/tests

# Local development only, MUST NOT be in image
app/local_dev

# IDE/editor files
.vscode/
.idea/
*.iml
.zed/

# environment files
.env
.env.*
